# Runtime name in the dashboard header and browser title.
APP_NAME="bifrost-usage-dashboard"
# Legacy runtime fallback when APP_NAME is unset or blank:
# NEXT_PUBLIC_APP_NAME="My Team Usage"
# Development: http://localhost:3000; production requires HTTPS.
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Tehran

# Direct internal address, bypassing the interactive SSO proxy.
BIFROST_BASE_URL=http://localhost:8080
BIFROST_ADMIN_USERNAME=
BIFROST_ADMIN_PASSWORD=
BIFROST_TIMEOUT_MS=8000

# Generate each independently: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
ACCESS_TOKEN_ENCRYPTION_KEY=
SESSION_ENCRYPTION_KEY=
